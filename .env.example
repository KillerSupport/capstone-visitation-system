# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MySQL (backend only)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bjmp_visitation

# Authentication: generate a random 32+ character value
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_HOURS=12
APP_ORIGIN=http://localhost:3000

# Optional SMTP email delivery (leave unset to disable email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS provider. Twilio-compatible REST API configuration.
SMS_PROVIDER=mock
SMS_API_URL=
SMS_ACCOUNT_ID=
SMS_AUTH_TOKEN=
SMS_FROM=

# KYC document encryption: set to a unique random 32-byte key (64 hex chars or base64). Never commit the real value.
KYC_ENCRYPTION_KEY=replace-with-64-hex-characters
# Accepted identity types (comma-separated)
ACCEPTED_ID_TYPES=Philippine National ID (PhilSys),Driver's License (LTO),Philippine Passport (DFA),UMID (Unified Multi-Purpose ID),Postal ID (Digitized),Social Security System (SSS) ID,Voter's ID / Comelec Certification,PRC Professional Identification Card,Senior Citizen ID,PhilHealth Identification Card
# Optional real biometric adapter status; no provider is connected in this project yet.
BIOMETRIC_PROVIDER=none

# Used only when creating an empty database. Passwords are hashed before insert.
INITIAL_ADMIN_EMAIL=admin@bjmp.gov.ph
INITIAL_ADMIN_PASSWORD=replace-with-a-random-12-character-or-longer-password
INITIAL_WORKER_EMAIL=worker@bjmp.gov.ph
INITIAL_WORKER_PASSWORD=replace-with-a-different-random-12-character-or-longer-password
