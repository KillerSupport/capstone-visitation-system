{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:frontend": "vite --config frontend/vite.config.ts --port=3000 --host=0.0.0.0",
    "server": "node --require ./scripts/node-runtime.cjs --import tsx backend/index.ts",
    "start": "node scripts/run-dev.mjs",
    "build": "vite build --config frontend/vite.config.ts",
    "build:production": "npm run build && node scripts/build-server.mjs",
    "start:production": "node scripts/start-production.mjs",
    "preview": "vite preview",
    "db:reset-demo": "tsx scripts/reset-demo-db.ts",
    "clean": "rm -rf frontend/dist server.js",
    "lint": "tsc --project frontend/tsconfig.json --noEmit && tsc --project backend/tsconfig.json --noEmit",
    "test:communications": "node --require ./scripts/node-runtime.cjs --import tsx --test tests/messaging.test.ts tests/visitor-communications.test.ts",
    "test:visitor-restrictions": "node --require ./scripts/node-runtime.cjs --import tsx --test tests/visitor-restrictions.test.ts",
    "db:migrate": "node --require ./scripts/node-runtime.cjs --import tsx scripts/migrate.ts",
    "db:seed-pdls": "node --require ./scripts/node-runtime.cjs --import tsx scripts/prepare-three-pdl-demo.ts",
    "db:seed-requested-pdls": "node --require ./scripts/node-runtime.cjs --import tsx scripts/prepare-three-pdl-demo.ts",
    "db:prepare-pdl-demo": "node --require ./scripts/node-runtime.cjs --import tsx scripts/prepare-three-pdl-demo.ts",
    "address:refresh": "node scripts/import-psgc.mjs",
    "test:features": "node --require ./scripts/node-runtime.cjs --import tsx --test tests/features.test.ts",
    "db:backup": "node --require ./scripts/node-runtime.cjs --import tsx scripts/backup-database.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.12",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
